{
	"schema": 1,
	"rig": "rapl",
	"date": "2026-10-26",
	"layer": "L1",
	"instrument": "RAPL package-0 energy counter (intel-rapl sysfs, read-only bind into the container)",
	"exclusions": ["windows where other containers used more than 100 ms of CPU per second"],
	"question": "package joules per minute in headless Chromium for quiet, polling and requestAnimationFrame pages, and for a loop off screen with and without a pause hook",
	"machine": {
		"name": "paisley-park",
		"cpu": "AMD Ryzen 9 9900X",
		"os": "Ubuntu 24.04",
		"governor": "powersave",
		"cpuidle": "acpi_idle, menu",
		"pstate": "amd-pstate-epp, EPP performance"
	},
	"software": {
		"browser": "Chromium (new headless), container mcr.microsoft.com/playwright:v1.62.1-noble, --memory 6g",
		"origin": "Node http server in the same container"
	},
	"method": {
		"arms": {
			"quiet": "a static page with no timers",
			"poll": "setInterval every 1000 ms, fetch() of a 204 endpoint",
			"raf": "a requestAnimationFrame loop that moves a composited 80 px box",
			"raf-off-plain": "the raf loop with its box at top 3000 px, off screen in a 900 px viewport",
			"raf-off-hook": "raf-off-plain plus the page runtime, which cancels the frame while the box is off screen"
		},
		"window s": 300,
		"rounds": 8,
		"idle window s": 60,
		"idle windows": "four per round, no browser running; the drift between them is in the rows",
		"arm order": "rotated per round; an idle window before the first arm, after every second arm and after the last",
		"settle": "the page loaded, then 8 s before the window opens",
		"visibility": "every row records document.visibilityState at the end of its window and a row that is not visible stops the run. A hidden-page arm is not run: no headless Chromium launch mode reports a backgrounded page as hidden (probe 2026-10-25, three modes), so the hook's hidden-time pause is covered by contract tests in three engines and has no power reading"
	},
