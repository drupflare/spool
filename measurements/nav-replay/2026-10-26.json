{
	"schema": 1,
	"rig": "nav-replay",
	"date": "2026-10-26",
	"layer": "L1",
	"question": "which provisioning arms repay their cost when replayed on a per-visitor sequence of page categories; the counts are L1, the net joules are L2 from those counts and the model constants, and the entry sizes are L1 for 473 and 17054 and L3 for 2048",
	"instrument": "replay of the MSNBC category sequences through NavModel and frozen first-order counts, with JOULES_PER_BYTE and ORIGIN_JOULES from src/protocol/provision.ts",
	"machine": {
		"name": "darwin arm64",
		"cpu": "Apple M2 Pro",
		"os": "darwin 25.5.0"
	},
	"software": {
		"runtime": "Bun 1.4.4",
		"node": "26.3.0"
	},
	"method": {
		"dataset": "msnbc.com anonymous web data (UCI ML Repository dataset 133)",
		"url": "https://archive.ics.uci.edu/dataset/133/msnbc+com+anonymous+web+data",
		"license": "CC BY 4.0 (UCI dataset page)",
		"file": "msnbc990928.seq, from msnbc990928.seq.gz in the UCI zip",
		"header": "comment lines, then one line per user of space-separated category numbers 1 to 17; categories are in header order",
		"categories": "frontpage, news, tech, local, opinion, on-air, misc, weather, msn-news, health, living, business, msn-sports, sports, summary, bbs, travel. Categories stand in for route classes; the data has no URLs.",
		"span": "one day, 28 September 1999 (file header); requests served by a cache are absent (file header)",
		"users": {
			"sequences": 989818,
			"train": 494909,
			"test": 494909
		},
		"sequence length": {
			"min": 1,
			"median": 2,
			"p90": 11,
			"max": 14795,
			"mean": 4.747129270229476
		},
		"scored steps": 1857311,
		"split": "user index parity: even index trains the population counts and is never scored; odd index is scored",
		"steps": "each position from the second of a test user; context is the routes before it, newest last. The first view of a user has no context and is not scored",
		"provision": "a candidate not yet held is provisioned when shouldAct gives true, with avoided = JOULES_PER_BYTE * documentBytes + ORIGIN_JOULES and provision = JOULES_PER_BYTE * entryBytes; no render, maintain or model term",
		"hit": "a first step is a hit when the held set holds the next route; a page the visitor already opened is held without a prediction, so it is never proposed and never counted",
		"hit@1 and hit@3": "the top 1 or top 3 proposals by p among pages the visitor had not opened, whatever shouldAct said; counted over first steps, the steps whose next route is new to the visitor",
		"joules": "netJ = hits * avoided - provisions * provision; netJPerKB = netJ / (provisionedBytes / 1000), null with no provisions",
		"z": "1.28 for the decision and 0 (the point estimate) for every arm",
		"documentBytes": "17054 B (DOCUMENT_BYTES, L1)",
		"entries": [
			{
				"bytes": 473,
				"layer": "L1",
				"source": "measurements/payload, median compressed rendered node"
			},
			{
				"bytes": 2048,
				"layer": "L3",
				"source": "scenario"
			},
			{
				"bytes": 17054,
				"layer": "L1",
				"source": "DOCUMENT_BYTES (src/report/inputs.ts)"
			}
		],
		"arms": {
			"none": "provisions nothing",
			"popularity": "the train share of each category as the next route, ignoring context",
			"population-1": "first-order train counts, frozen",
			"population-first": "population-1 counting only transitions to a page the visitor had not opened, over every transition from the page (what a server can compute from view events)",
			"device-1": "a fresh NavModel per test user, order 1, no prior",
			"blend-1": "a fresh NavModel per test user, order 1, prior = train first-order counts, alpha 5",
			"blend-2": "as blend-1 with order 2 and halfLife 50",
			"oracle": "proposes the true next route with p 1 and weight 1e9"
		},
		"calibration": "rows with kind calibration: for each arm but none and oracle, every candidate the visitor had not opened at each scored step is binned by its probability (edges 0, 0.05, 0.1, 0.2, 0.4, 1); predicted is the mean probability in the bin and observed the share that was the next route",
		"limits": "each visitor here is one session of a few pages on one day, so a device history is one session; the multi-day device learning the product relies on is not tested by this data. Categories are not URLs, and the data is a 1999 news portal."
	},
	"exclusions": [
		"the first view of each test user (no context)",
		"even-index users (population counts, never scored)",
		"blank and comment lines of the file (header, no user)"
	],
