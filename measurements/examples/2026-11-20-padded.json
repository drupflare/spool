{
	"schema": 1,
	"rig": "examples",
	"date": "2026-11-20",
	"layer": "L1",
	"question": "requests, origin calls and response bytes of the same visit script with spool and with no spool, per example site",
	"instrument": "a counting wrapper around each node listener handler; a counting proxy in front of wrangler dev --local; Playwright persistent contexts",
	"machine": {
		"name": "paisley-park",
		"cpu": "AMD Ryzen 9 9900X 12-Core Processor",
		"os": "linux 6.8.0-138-generic"
	},
	"software": {
		"node": "v26.3.0",
		"spool": "1.0.0",
		"@playwright/test": "1.64.1",
		"wrangler": "4.151.1",
		"chromium": "156.0.8078.80",
		"firefox": "157.0"
	},
	"method": {
		"sites": ["courses", "campus", "blog", "homepage", "dashboard"],
		"arms": ["spool", "no-spool"],
		"engines": ["chromium", "firefox"],
		"views": [1, 2, 3, 10, 100],
		"checkpoints": [1, 2, 3, 10, 100],
		"dwell_ms": {
			"chromium": 0,
			"firefox": 0
		},
		"click_gap_ms": 150,
		"document_every": 6,
		"reader": "view 1 and every sixth view open a typed path with page.goto; other views click one same-origin link the page offers, chosen by an FNV-1a hash of site and view; a page with no link takes a synthetic anchor to the typed path",
		"loopback_port": 6252,
		"worker": "skipped",
		"visits": {
			"courses": ["/courses", "/courses/101", "/courses/102", "/courses/103"],
			"campus": [
				"/courses",
				"/courses/101",
				"/catalogue?department=web",
				"/people/ada",
				"/news/2026/pack-release",
				"/teams/web"
			],
			"blog": [
				"/",
				"/posts/09999",
				"/posts/09998",
				"/authors/ada",
				"/archive/2024/01",
				"/tags?tag=web"
			],
			"homepage": [
				"/",
				"/news",
				"/news/story-01",
				"/events",
				"/events/event-01",
				"/departments"
			],
			"dashboard": [
				"/me",
				"/projects/site",
				"/projects/app",
				"/tasks",
				"/tasks/t1",
				"/tasks/t4"
			]
		},
		"doc_bytes": 17054,
		"design": "padded: a hidden block of 17054 bytes in the page layout of every site page, in both arms and in each template; the rows are unchanged; the worker entries take no padding, so their runs are skipped"
	},
	"exclusions": [
		"a run that throws stops the rig and writes no reading; the draft stays in the work folder",
		"the worker counts forwarded requests; origin calls are not counted inside a worker",
		"off_path counts views whose location did not reach the target path; a reading with off_path above 0 has a view the reader did not take"
	],
