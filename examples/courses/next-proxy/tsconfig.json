	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"@drupflare/spool/protocol": ["../../../dist/protocol/index.js"],
			"@drupflare/spool/server": ["../../../dist/server/index.js"],
