{
	"schema": 1,
	"rig": "demand",
	"date": "2026-11-20",
	"layer": "L1",
	"question": "Origin requests, Worker-invocation equivalents and bytes per device per day, with and without spool, for visitors who return after one lease or more, per engine.",
	"instrument": "Playwright persistent contexts reopened on one profile each day; the wall clock of the server and the browser moved together by libfaketime reading an offset file; every request that reaches the origin handler is counted with its method, path, response bytes, day and view.",
	"machine": {
		"name": "paisley-park",
		"cpu": "AMD Ryzen 9 9900X 12-Core Processor",
		"os": "linux 6.8.0-138-generic",
		"container": "spool-v1-browser:1",
		"loadAverageAtStart": "0.24 0.53 1.09"
	},
	"software": {
		"node": "v26.3.0",
		"bun": "1.4.5",
		"playwright": "1.64.1",
		"faketime": "libfaketime preloaded from /usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1, version not read"
	},
	"method": {
		"scenarios": [
			{
				"name": "Daily reader: one document a day, 5 days",
				"views": [1, 1, 1, 1, 1],
				"gapH": 25
			},
			{
				"name": "Local-only reader across three leases",
				"views": [3, 2, 2, 2],
				"gapH": 25
			}
		],
		"arms": ["baseline", "spool"],
		"engines": ["chromium", "firefox"],
		"courses": 1000,
		"dwellMs": 1500,
		"settleMs": 1500,
		"tailMs": 6000,
		"clockWaitMs": 2500,
		"bootstrap": "second-view",
		"swap": true,
		"leaseSeconds": 86400,
		"noCache": "1",
		"dontFakeMonotonic": "1",
		"realEpochMs": "1795143971507"
	},
	"exclusions": [
		"the monotonic clock is not faked; waits and timers run in real time, so a lease is crossed by the wall clock only",
		"a row with fatal set did not finish its arm; its days hold the counts of the days that started",
		"a row with wrong above 0 has a page that did not show the course title; a reader drops it",
		"dynamic counts every request but the stub and the scripts; it is the invocation count only when a static tier serves those (L2 over the hit log)",
		"the dataset never changes, so a sync carries no patch; the bytes of a sync that carries a change are not in this reading",
		"a Firefox row that failed to start under the preloaded library is the result for that engine"
	],
