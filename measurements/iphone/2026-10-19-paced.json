{
	"schema": 1,
	"rig": "iphone",
	"date": "2026-10-19",
	"layer": "L1",
	"question": "phone joules per view, network vs spool, one view every 15 s",
	"instrument": "AppleSmartBattery PowerTelemetryData via libimobiledevice idevicediagnostics: AccumulatedSystemEnergyConsumed (uWh) for energy_j, AccumulatedSystemLoad / count for mean_mw; 20 s ticks",
	"machine": {
		"name": "iPhone 14 Pro",
		"os": "iOS 26.6.2",
		"network": "Wi-Fi (eduroam)",
		"power": "wired to the Mac"
	},
	"software": {
		"browser": "Safari, driven by safaridriver (W3C WebDriver)",
		"origins": "Cloudflare Workers static assets (free plan), demo.drupflare.com mirror, analytics token zeroed"
	},
	"method": {
		"arms": ["network", "spool", "idle"],
		"arm order": "rotated per round",
		"window ticks": 9,
		"pages": ["/", "/node/3", "/node/2", "/node/1"],
		"pace s": 15,
		"service worker": "registered in the same session with updateViaCache all; controlled asserted before the run"
	},
	"exclusions": [
		"windows with any tick charging true: the energy counter then includes charge power"
	],
