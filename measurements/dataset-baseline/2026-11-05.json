{
	"schema": 1,
	"rig": "dataset-baseline",
	"date": "2026-11-05",
	"layer": "L1",
	"question": "exact response bytes, route load runs and sync bytes of the v0.3 artifact for a held collection of 50, 500 and 5000 rows, after one row, ten rows, one percent of rows, one delete or one add, as a list of rows or as records; the same changes through the v0.4 dataset patch applied by the worker store (requests, bytes, rows written, row hashes); and whether the query proof verifies on the server and on the client after materialize",
	"instrument": "spool.respond on an in-process createSpool with a memory store, no browser; node:zlib gzip and brotli of each response body; load runs counted inside the route; the v0.4 arm runs the worker store (Replica over memoryStorage, syncDataset) with commits and row hashes counted",
	"machine": {
		"name": "darwin arm64",
		"cpu": "Apple M2 Pro",
		"os": "darwin 25.5.0"
	},
	"software": {
		"runtime": "bun 1.4.4",
		"zlib": "node:zlib, default levels"
	},
	"method": {
		"route": "template strategy, query { list: \"rows\" }, depends [\"dataset\"], loads counted",
		"shapes": {
			"list": "the rows inline in the data; the proof is over the rows",
			"records": "each row registered with ctx.record; the list holds refs; the proof is over the resolved rows (the 2026-11-03 reading used a proof over the refs, which the client check refused)"
		},
		"changes": {
			"change-1, change-10, change-1pct": "bump dataset, and the row tag of each changed row in the records shape; change-1pct is max(2, ceil(N / 100)) rows",
			"delete-1, add-1": "bump dataset only"
		},
		"refetch": "each scenario runs on a fresh spool: seed, change, then one refetch with have and one without, both in the same state; then /.spool/sync from the seed vector",
		"have": "the seed record ids and versions, the first 256 when there are more; a full have above 256 is sent once as fullHave",
		"gates": {
			"as shipped": "default provision priors",
			"gate open": "route provision { reuse: 1, futureViews: 1000 }, so benefit() is positive at every size here"
		},
		"proof": "gate open arm: verifyProof on the built data, Graph.put and materialize from src/sw/graph, then verifyProof and shapeQuery on the materialized data",
		"v04": "kind v04 rows: a dataset \"rows\" on a backend that keeps its digest; the device seeds with syncDataset, one change is made, then one more sync; seed and patch bytes are the sum of the responses of that phase; puts, deletes and commits are what the store wrote; rowHashes counts row hashes the device computed",
		"dataProbe": "a data route with default priors, one row, to check the gate on that strategy",
		"titles": "40 to 80 ASCII characters from a seeded generator",
		"bytes": "raw response body; a 204 is a declined artifact and counts 0 bytes",
		"origin": "in process"
	},
	"exclusions": [
		"none; a row with status 204 is a declined artifact with 0 bytes, kept as measured"
	],
