	"date": "2026-10-26",
	"layer": "L1",
	"instrument": "RAPL package-0 energy counter (intel-rapl sysfs, read-only bind into the container)",
	"exclusions": ["windows where other containers used more than 100 ms of CPU per second"],
	"question": "package joules per minute in a headed Chromium under a virtual display for a quiet page and a polling page, each in a tab behind another tab, with and without the page runtime pausing the poll",
	"machine": {
		"name": "paisley-park",
		"cpu": "AMD Ryzen 9 9900X",
		"os": "Ubuntu 24.04",
		"governor": "powersave",
		"cpuidle": "acpi_idle, menu",
		"pstate": "amd-pstate-epp, EPP performance"
	},
	"software": {
		"browser": "Chromium (new headless), container mcr.microsoft.com/playwright:v1.62.1-noble, --memory 6g",
		"display": "Xvfb through xvfb-run, no window manager",
		"driver": "raw CDP over a WebSocket (no Playwright, which turns on focus emulation and makes every tab report visible)",
		"origin": "Node http server in the same container"
	},
	"method": {
		"arms": {
			"quiet-hidden": "a static page with no timers, in a tab behind another",
			"poll-hidden-plain": "setInterval every 1000 ms with a fetch() of a 204 endpoint, in a tab behind another",
			"poll-hidden-hook": "poll-hidden-plain plus the page runtime, which clears the interval once the page has been hidden for 1000 ms"
		},
		"window s": 300,
		"rounds": 8,
		"idle window s": 60,
		"idle windows": "three or four per round, no browser running; the drift between them is in the rows",
		"arm order": "rotated per round; an idle window before the first arm, after every second arm and after the last",
		"settle": "the page loaded, a second tab opened and brought to the front, then 8 s before the window opens",
		"visibility": "every row records document.visibilityState of the first tab at the end of its window, and a row that is not hidden stops the run"
	},
