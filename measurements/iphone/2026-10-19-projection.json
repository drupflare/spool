{
	"schema": 1,
	"rig": "iphone",
	"date": "2026-10-19",
	"layer": "L1",
	"question": "phone joules per view: network fetch of a computed page, local render of it, and a local render that aggregates stored records on the device",
	"instrument": "AppleSmartBattery PowerTelemetryData via libimobiledevice idevicediagnostics: AccumulatedSystemEnergyConsumed (uWh) for energy_j, AccumulatedSystemLoad / count for mean_mw; 20 s ticks",
	"machine": {
		"name": "iPhone 14 Pro",
		"os": "iOS 26.6.2",
		"network": "Wi-Fi (eduroam)",
		"power": "wired to the Mac"
	},
	"software": {
		"browser": "Safari, driven by safaridriver (W3C WebDriver)",
		"origins": "two Cloudflare Workers static-assets sites (free plan), one without a service worker and one with"
	},
	"method": {
		"arms": {
			"net-baked": "network fetch of the already-computed page",
			"spool-baked": "local render of the same page",
			"spool-proj": "local render plus on-device aggregation of the stored records",
			"net-proj": "network page plus aggregation, records from the HTTP cache",
			"idle": "screen on, no navigation"
		},
		"rounds": 3,
		"window ticks": 5,
		"pace s": 0,
		"arm order": "rotated per round",
		"records": "synthetic, 97,000 rows, 1.63 MB JSON",
		"record rows": 97000,
		"record bytes": 1630000,
		"service worker": "registered in the same session with updateViaCache all; controlled asserted before the run"
	},
	"exclusions": [
		"windows with any tick charging true: the energy counter then includes charge power"
	],
