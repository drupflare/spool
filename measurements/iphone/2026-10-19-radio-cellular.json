		"browser": "Safari, driven by safaridriver (W3C WebDriver)",
		"origin": "a Cloudflare Worker (free plan) answering GET /ping with 204 and no body"
	},
	"method": {
		"arms": ["request", "script", "idle"],
		"request": "one WebDriver async script per slot that runs fetch('/ping?<time>', {cache: 'no-store'})",
