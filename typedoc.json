{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": [
		"src/index.ts",
		"src/protocol/index.ts",
		"src/server/index.ts",
		"src/node/listener.ts",
		"src/proxy/index.ts",
		"src/stores/index.ts",
		"src/stores/durable-object.ts",
		"src/sw/index.ts",
		"src/client/index.ts",
		"src/report/index.ts",
		"src/trim/index.ts",
		"src/media/index.ts",
		"src/express/index.ts",
		"src/hono/index.ts",
		"src/vite/index.ts",
		"src/nuxt/index.ts",
		"src/next/index.ts",
		"src/react-router/index.ts",
		"src/vue/index.ts",
		"src/angular/index.ts"
	],
	"alwaysCreateEntryPointModule": false,
	"tsconfig": "tsconfig.docs.json",
	"skipErrorChecking": true,
	"out": "typedoc",
	"name": "@drupflare/spool",
	"readme": "README.md",
	"projectDocuments": [
		"docs/getting-started.md",
		"docs/configuration.md",
		"ADVANCED_USAGE.md",
		"docs/adapters/README.md",
		"docs/adapters/cloudflare-workers.md",
		"docs/adapters/cloudflare-pages-functions.md",
		"docs/adapters/hono.md",
		"docs/adapters/elysia.md",
		"docs/adapters/itty-router.md",
		"docs/adapters/bun.md",
		"docs/adapters/deno.md",
		"docs/adapters/netlify-functions.md",
		"docs/adapters/netlify-edge-functions.md",
		"docs/adapters/vercel-functions.md",
		"docs/adapters/nextjs.md",
		"docs/adapters/nuxt-and-nitro.md",
		"docs/adapters/nuxt-module.md",
		"docs/adapters/react-router.md",
		"docs/adapters/next-adapter.md",
		"docs/adapters/vite.md",
		"docs/adapters/vue.md",
		"docs/adapters/angular.md",
		"docs/adapters/aws-lambda.md",
		"docs/adapters/azure-functions.md",
		"docs/adapters/node.md",
		"docs/adapters/express.md",
		"docs/adapters/fastify.md",
		"docs/adapters/koa.md",
		"docs/adapters/hapi.md",
		"docs/adapters/nestjs.md",
		"docs/adapters/google-cloud-functions.md",
		"docs/impact.md",
		"docs/economics.md",
		"docs/protocol.md",
		"docs/security.md",
		"SECURITY.md",
		"TECHNICAL_REPORT.md"
	],
	"favicon": "docs/favicon.ico",
	"customJs": "scripts/docs/render.js",
	"customCss": "scripts/docs/render.css",
	"highlightLanguages": [
		"bash",
		"console",
		"css",
		"html",
		"javascript",
		"json",
		"jsonc",
		"json5",
		"tsx",
		"typescript",
		"sql",
		"diff",
		"toml",
		"yaml"
	],
	"ignoredHighlightLanguages": ["mermaid", "math"],
	"locales": { "en": { "kind_plural_document": "Guides" } },
	"groupOrder": ["Guides", "*"],
	"navigation": { "includeGroups": true },
	"includeVersion": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"intentionallyNotExported": ["Bytes", "MaybePromise", "Plain", "StoredHead"],
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": false
	},
	"treatWarningsAsErrors": false
}
