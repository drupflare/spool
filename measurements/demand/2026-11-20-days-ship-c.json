{
	"schema": 1,
	"rig": "demand",
	"date": "2026-11-20",
	"layer": "L1",
	"question": "Origin requests, Worker-invocation equivalents and bytes per device per day, with and without spool, for visitors who return after one lease or more, per engine.",
	"instrument": "Playwright persistent contexts reopened on one profile each day; the wall clock of the server and the browser moved together by libfaketime reading an offset file; every request that reaches the origin handler is counted with its method, path, response bytes, day and view.",
	"machine": {
		"name": "paisley-park",
		"cpu": "AMD Ryzen 9 9900X 12-Core Processor",
		"os": "linux 6.8.0-138-generic",
		"container": "spool-v1-browser:1",
		"loadAverageAtStart": "0.17 0.56 3.16"
	},
	"software": {
		"node": "v26.3.0",
		"bun": "1.4.5",
		"playwright": "1.64.1",
		"faketime": "libfaketime preloaded from /usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1, version not read"
	},
	"method": {
		"scenarios": [
			{
				"name": "Principal reader, session stays valid, persistent retention and depends on members",
				"views": [3, 1, 1, 1],
				"gapH": 25,
				"site": "live",
				"pages": "me",
				"login": "ada",
				"variant": "persistent"
			},
			{
				"name": "Principal reader, session ends on the server after day 2, persistent retention and depends on members",
				"views": [3, 1, 1, 1],
				"gapH": 25,
				"site": "live",
				"pages": "me",
				"login": "ada",
				"revokeAfterDay": 2,
				"variant": "persistent"
			},
			{
				"name": "Principal reader, session stays valid, persistent retention and depends on members, members maxStaleMs 48 h",
				"views": [3, 1, 1, 1],
				"gapH": 25,
				"site": "live",
				"pages": "me",
				"login": "ada",
				"variant": "persistent",
				"membersMaxStaleMs": 172800000
			},
			{
				"name": "Principal reader, session ends on the server after day 2, persistent retention and depends on members, members maxStaleMs 48 h",
				"views": [3, 1, 1, 1],
				"gapH": 25,
				"site": "live",
				"pages": "me",
				"login": "ada",
				"revokeAfterDay": 2,
				"variant": "persistent",
				"membersMaxStaleMs": 172800000
			}
