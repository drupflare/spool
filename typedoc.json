{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": [
		"src/index.ts",
		"src/protocol/index.ts",
		"src/server/index.ts",
		"src/node/listener.ts",
		"src/proxy/index.ts",
		"src/stores/index.ts",
		"src/stores/durable-object.ts",
		"src/sw/index.ts",
		"src/client/index.ts",
		"src/report/index.ts",
		"src/trim/index.ts",
		"src/media/index.ts"
	],
	"alwaysCreateEntryPointModule": false,
	"tsconfig": "tsconfig.docs.json",
	"skipErrorChecking": true,
	"out": "typedoc",
	"name": "@drupflare/spool",
	"readme": "README.md",
	"projectDocuments": ["docs/impact.md", "docs/protocol.md", "docs/security.md"],
	"customJs": "scripts/docs/render.js",
	"customCss": "scripts/docs/render.css",
	"highlightLanguages": [
		"bash",
		"console",
		"css",
		"html",
		"javascript",
		"json",
		"jsonc",
		"json5",
		"tsx",
		"typescript",
		"sql",
		"diff",
		"toml",
		"yaml"
	],
	"ignoredHighlightLanguages": ["mermaid", "math"],
	"locales": { "en": { "kind_plural_document": "Guides" } },
	"groupOrder": ["Guides", "*"],
	"navigation": { "includeGroups": true },
	"includeVersion": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"validation": {
		"notExported": true,
		"invalidLink": true,
		"notDocumented": true
	},
	"treatWarningsAsErrors": false
}
