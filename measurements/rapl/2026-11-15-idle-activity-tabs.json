{
	"schema": 1,
	"rig": "rapl",
	"date": "2026-11-15",
	"layer": "L1",
	"instrument": "RAPL package-0 energy counter (intel-rapl sysfs, read-only bind into the container)",
	"exclusions": ["windows where other containers used more than 100 ms of CPU per second"],
	"question": "package joules per minute in a headed Chromium under a virtual display for one tab, for three tabs with every tab polling, for three tabs with one leader polling, for three quiet tabs, and for one tab hidden long enough for intensive throttling",
	"machine": {
		"name": "paisley-park",
		"cpu": "AMD Ryzen 9 9900X",
		"os": "Ubuntu 24.04",
		"governor": "powersave",
		"cpuidle": "acpi_idle, menu",
		"pstate": "amd-pstate-epp, EPP performance"
	},
	"software": {
		"browser": "Chromium (new headless), container mcr.microsoft.com/playwright:v1.62.1-noble, --memory 6g",
		"display": "Xvfb through xvfb-run, no window manager",
		"driver": "raw CDP over a WebSocket (no Playwright, which turns on focus emulation and makes every tab report visible)",
		"origin": "Node http server in the same container"
	},
	"method": {
		"arms": {
			"tabs-1-poll": "one tab, setInterval every 1000 ms with a fetch() of a 204 endpoint: the control",
			"tabs-3-poll": "three tabs in one window, each polling as tabs-1-poll does; the first is visible and the two others hidden",
			"tabs-3-leader": "three tabs; the tab that holds the Web Lock \"poll\" polls every 1000 ms and posts each result on a BroadcastChannel, and the other two only listen. The leader is written in the rig page, not in spool, which ships no leader election",
			"tabs-3-quiet": "three tabs in one window with no timers: the floor of three open tabs",
			"poll-hidden-long": "one tab polling as tabs-1-poll does, hidden for at least 330 s before its window opens, so that Chromium has started intensive throttling"
		},
		"window s": 60,
		"long window s": 120,
		"rounds": 6,
		"idle window s": 30,
		"idle windows": "four per round, no browser running; the drift between them is in the rows",
		"arm order": "rotated per round; an idle window before the first arm, after every second arm and after the last",
		"settle": "the first tab loaded, the other tabs opened, the first tab brought to the front, then 8 s before a short window opens; a long window opens 330 s after the first tab was hidden",
		"hidden time": "hiddenForS on each row: seconds from the front tab last changing to the window start",
		"counts": "pageEvents: polls sent by every tab in the window; leaderPolls: polls sent by the tab that held the lock; messages: BroadcastChannel messages received by every tab",
		"visibility": "every row records document.visibilityState of each tab at the end of its window; a row whose tabs are not the expected set stops the run"
	},
