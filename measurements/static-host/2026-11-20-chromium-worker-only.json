{
	"schema": 1,
	"rig": "static-host",
	"date": "2026-11-20",
	"layer": "L1",
	"question": "Worker invocations, asset requests and bytes per client for a visitor on a Worker with an assets folder, with the stub, runtime and packs served by the Worker, by files without a stamp, by files with a stamp, and with no spool.",
	"instrument": "wrangler dev --local (workerd) running a counting Worker over an assets folder; a counting proxy in front that logs each response and which side answered; the Worker's own invocation counter read at phase boundaries; Playwright persistent contexts",
	"machine": {
		"name": "paisley-park",
		"cpu": "AMD Ryzen 9 9900X 12-Core Processor",
		"os": "linux 6.8.0-138-generic",
		"container": "spool-v1-browser:1",
