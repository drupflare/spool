		"playwright": "1.64.1",
		"faketime": "libfaketime preloaded from /usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1, version not read"
	},
	"method": {
		"scenarios": [
			{
				"name": "Daily reader: one document a day, 5 days",
				"views": [1, 1, 1, 1, 1],
				"gapH": 25,
				"site": "courses",
				"pages": "spread"
			},
			{
				"name": "Local-only reader across three leases",
				"views": [3, 2, 2, 2],
				"gapH": 25,
				"site": "courses",
				"pages": "spread"
			},
			{
				"name": "Public edit: a held course changes between days",
