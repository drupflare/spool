		"idle": "no calls",
		"arm order": "rotated per round",
		"window ticks": 9,
		"slot s": 20,
		"page": "the origin's small HTML page, loaded once before the first window"
	},
	"exclusions": [
		"windows with any tick charging true: the energy counter then includes charge power"
